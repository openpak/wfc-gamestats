[Unit]
Description=OpenPak WFC gamestats
After=openpak-postgres.service

[Container]
ContainerName=openpak-wfc-gamestats
Image=ghcr.io/openpak/wfc-gamestats:latest
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/wfc-full/wfc-gamestats.env
Volume=%h/openpak/deploy/wfc-split/token.key:/keys/wfc-token.key:ro,U
PublishPort=0.0.0.0:29920:29920/tcp

[Service]
Restart=always

[Install]
WantedBy=default.target
